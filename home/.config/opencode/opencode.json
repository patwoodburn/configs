{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@api-sdk/openai-compatible",
      "name": "ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder": {
          "name": "qwen3-coder",
        }
      }
    }
  },
  "agent": {
    "notetaker": {
      "description": "Zettelkasten-style note management agent for creating, organizing, and maintaining atomic notes",
      "mode": "primary",
      "model": "github-copilot/gpt-4.1",
      "prompt": "{file:~/.config/opencode/prompts/notetaker.txt}",
      "tools": {
        "bash": true,
        "list": true
      },
      "permission": {
        "external_directory": {
          "$HOME/Documents/Notes/*": "allow"
        }
      }
    }
  }
}
